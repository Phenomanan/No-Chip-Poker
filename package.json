{
  "name": "no-chip-poker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:server": "tsc -p tsconfig.json",
    "dev:server": "npx tsx watch apps/server/src/index.ts",
    "test:rules-engine": "npm run build:server && node scripts/test-rules-engine.mjs",
    "test:pot-regression": "npm run build:server && node scripts/test-pot-regression.mjs",
    "test:admin-controls": "npm run build:server && node scripts/test-admin-controls.mjs",
    "test:session-handling": "npm run build:server && node scripts/test-session-handling.mjs",
    "test:soak": "npm run build:server && node scripts/test-four-player-soak.mjs",
    "test": "npm run build:server && node scripts/test-rules-engine.mjs && node scripts/test-rules-properties.mjs && node scripts/test-pot-regression.mjs && node scripts/test-admin-controls.mjs && node scripts/test-session-handling.mjs && node scripts/test-kick-and-reorder.mjs && node scripts/test-deal-gate.mjs && node scripts/test-four-player-soak.mjs && FUZZ_TABLES=3 FUZZ_HANDS=8 node scripts/test-fuzz.mjs",
    "test:properties": "npm run build:server && node scripts/test-rules-properties.mjs",
    "test:ui": "npm run build:server && node scripts/test-ui.mjs",
    "test:deal-gate": "npm run build:server && node scripts/test-deal-gate.mjs",
    "test:kick-reorder": "npm run build:server && node scripts/test-kick-and-reorder.mjs",
    "test:fuzz": "npm run build:server && node scripts/test-fuzz.mjs"
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/node": "^18.19.119",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "nanoid": "^5.1.5",
    "socket.io": "^4.8.1",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.3"
  }
}
